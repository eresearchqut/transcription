{
  "mappings": [
    {
      "name": "Issues a token to the local client, whose credentials put-local-dmp-credentials.ts writes to Parameter Store",
      "request": {
        "method": "POST",
        "url": "/oauth2/token",
        "basicAuthCredentials": {
          "username": "transcription-local",
          "password": "transcription-local-secret"
        },
        "formParameters": {
          "grant_type": { "equalTo": "client_credentials" }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "access_token": "mock-dmp-access-token",
          "expires_in": 3600,
          "token_type": "Bearer"
        }
      }
    },
    {
      "name": "Refuses any other client, as Cognito does",
      "priority": 10,
      "request": { "method": "POST", "url": "/oauth2/token" },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "error": "invalid_client" }
      }
    }
  ]
}
