{
  "mappings": [
    {
      "name": "Refuses a request without the token the local client is issued",
      "priority": 1,
      "request": {
        "urlPathPattern": "/v1/.*",
        "headers": {
          "Authorization": {
            "not": { "equalTo": "Bearer mock-dmp-access-token" }
          }
        }
      },
      "response": {
        "status": 401,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "statusCode": 401, "message": "Unauthorized" }
      }
    },
    {
      "name": "Refuses a status that is not a PlanStatus",
      "priority": 2,
      "request": {
        "method": "GET",
        "urlPathPattern": "/v1/rpid/user/[^/]+(/[^/]+)?",
        "queryParameters": {
          "status": {
            "not": {
              "or": [{ "absent": true }, { "matches": "ACTIVE|ARCHIVED" }]
            }
          }
        }
      },
      "response": {
        "status": 400,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "statusCode": 400,
          "message": "Validation failed (enum string is expected)",
          "error": "Bad Request"
        }
      }
    },
    {
      "name": "Answers for a known researcher's RPID that no other stub matched",
      "priority": 8,
      "request": {
        "method": "GET",
        "urlPathPattern": "/v1/rpid/user/(researcher1001|researcher2002)/[^/]+"
      },
      "response": {
        "status": 404,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "statusCode": 404,
          "message": "No plan found for researcher",
          "error": "Not Found"
        }
      }
    },
    {
      "name": "Answers for any other researcher",
      "priority": 9,
      "request": {
        "method": "GET",
        "urlPathPattern": "/v1/rpid/user/[^/]+(/[^/]+)?"
      },
      "response": {
        "status": 404,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "statusCode": 404,
          "message": "No researcher found",
          "error": "Not Found"
        }
      }
    }
  ]
}
