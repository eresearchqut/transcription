{
  "mappings": [
    {
      "name": "Lists researcher1001's active plans",
      "request": {
        "method": "GET",
        "urlPath": "/v1/rpid/user/researcher1001",
        "queryParameters": { "status": { "equalTo": "ACTIVE" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "researcher1001/active.json"
      }
    },
    {
      "name": "Lists researcher1001's archived plans",
      "request": {
        "method": "GET",
        "urlPath": "/v1/rpid/user/researcher1001",
        "queryParameters": { "status": { "equalTo": "ARCHIVED" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "researcher1001/archived.json"
      }
    },
    {
      "name": "Lists all of researcher1001's plans",
      "request": {
        "method": "GET",
        "urlPath": "/v1/rpid/user/researcher1001",
        "queryParameters": { "status": { "absent": true } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "researcher1001/all.json"
      }
    },
    {
      "name": "Gets an active plan of researcher1001",
      "request": {
        "method": "GET",
        "urlPathTemplate": "/v1/rpid/user/researcher1001/{rpid}",
        "pathParameters": {
          "rpid": { "matches": "A1B2C3D4|E5F6G7H8" }
        },
        "queryParameters": {
          "status": { "or": [{ "absent": true }, { "equalTo": "ACTIVE" }] }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "plans/{{request.path.rpid}}.json",
        "transformers": ["response-template"]
      }
    },
    {
      "name": "Gets an archived plan of researcher1001",
      "request": {
        "method": "GET",
        "urlPath": "/v1/rpid/user/researcher1001/J9K0L1M2",
        "queryParameters": {
          "status": { "or": [{ "absent": true }, { "equalTo": "ARCHIVED" }] }
        }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "plans/J9K0L1M2.json"
      }
    },
    {
      "name": "Refuses researcher1001's archived plan as an active one",
      "request": {
        "method": "GET",
        "urlPath": "/v1/rpid/user/researcher1001/J9K0L1M2",
        "queryParameters": { "status": { "equalTo": "ACTIVE" } }
      },
      "response": {
        "status": 404,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "statusCode": 404,
          "message": "The RPID exists, but the plan does not have the requested status.",
          "error": "Not Found"
        }
      }
    },
    {
      "name": "Refuses researcher1001 a plan they are not on",
      "request": {
        "method": "GET",
        "urlPath": "/v1/rpid/user/researcher1001/N3P4Q5R6"
      },
      "response": {
        "status": 403,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "statusCode": 403,
          "message": "The user does not have access to this RPID.",
          "error": "Forbidden"
        }
      }
    },
    {
      "name": "Refuses researcher1001 a plan they collaborate on without access to transcription",
      "request": {
        "method": "GET",
        "urlPath": "/v1/rpid/user/researcher1001/S7T8U9V0"
      },
      "response": {
        "status": 403,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "statusCode": 403,
          "message": "The collaborator does not have access to perform this operation on this RPID.",
          "error": "Forbidden"
        }
      }
    }
  ]
}
