{
    "name": "api",
    "version": "1.0.0",
    "description": "API for the Transcription Service",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "clean": "rimraf node_modules",
        "build": "tsc",
        "test": "AWS_XRAY_CONTEXT_MISSING=LOG_ERROR AWS_XRAY_LOG_LEVEL=silent jest --maxWorkers 1",
        "fmt": "prettier --write .",
        "fmt:check": "prettier --check .",
        "lint": "eslint --fix '**/*.{ts,tsx}'",
        "lint:check": "eslint '**/*.{ts,tsx}'"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.741.0",
        "@aws-sdk/client-dynamodb": "^3.741.0",
        "@aws-sdk/client-s3": "^3.741.0",
        "@aws-sdk/client-transcribe": "^3.741.0",
        "@aws-sdk/util-dynamodb": "^3.741.0",
        "@vendia/serverless-express": "^4.10.4",
        "aws-xray-sdk": "^3.5.1",
        "body-parser": "^1.20.3",
        "cors": "^2.8.5",
        "express": "^4.21.1",
        "model": "workspace:1.0.0"
    },
    "devDependencies": {
        "@smithy/util-stream": "^4.0.2",
        "@trivago/prettier-plugin-sort-imports": "^4.3.0",
        "@types/aws-lambda": "^8.10.119",
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.13",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@typescript-eslint/parser": "8.50.0",
        "@typescript-eslint/eslint-plugin": "^8.50.0",
        "aws-sdk-client-mock": "^4.1.0",
        "aws-sdk-client-mock-jest": "^4.1.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "^30.2.0",
        "jest-dynalite": "^3.6.1",
        "prettier": "^3.0.3",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.4.5",
        "typescript": "5.5.4"
    },
    "prettier": {
        "importOrder": [
            "^react",
            "^[\\w\\d]+",
            "^[./]"
        ],
        "importOrderSeparation": true,
        "plugins": [
            "@trivago/prettier-plugin-sort-imports"
        ]
    }
}
