{
  "name": "transcription",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "api",
    "deployment",
    "frontend",
    "model"
  ],
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "clean": "pnpm recursive run clean && rimraf node_modules",
    "build": "pnpm recursive run build",
    "dev": "pnpm ministack:up && pnpm ministack:env && pnpm ministack:seed-users && pnpm dev:frontend",
    "dev:frontend": "pnpm --filter \"frontend^...\" build && pnpm --filter frontend dev",
    "test": "pnpm recursive run test",
    "test:integration": "pnpm --filter api test:integration",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "fixtures": "node api/test/fixtures/build-transcribe-fixtures.mts",
    "ministack:seed-users": "node scripts/ministack/seed-cognito-users.mjs",
    "ministack:env": "node scripts/ministack/write-frontend-env.mjs",
    "ministack:up": "docker compose up -d --build --wait",
    "ministack:down": "docker compose down",
    "ministack:logs": "docker compose logs -f transcription-bootstrap",
    "ministack:deploy": "pnpm ministack:build && docker compose exec -w /app/deployment transcription-bootstrap cdklocal deploy --all --require-approval never --output /tmp/cdk.out.deploy",
    "ministack:build": "docker compose exec -w /app transcription-bootstrap pnpm --filter \"api^...\" build"
  },
  "author": "eResearch",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "rimraf": "^6.1.3"
  }
}
